# Desenvolvimento local permanece BYOK e usa IndexedDB. O backend de produção
# mantém as chaves no servidor e usa Supabase com sessão opaca segura.
# No desenvolvimento local (`npm run dev`), OPENROUTER pré-popula o provider
# se este navegador ainda não tiver uma chave ativa. A alternativa legada
# VITE_DEV_OPENROUTER_API_KEY também é aceita. Reinicie o Vite após editar .env.
# O auto-seed fica desativado em `--mode test` e no build de produção.
OPENROUTER=

# Chave opcional de avaliação textual das referências de imagem. Usada somente
# no gateway local, sem ser enviada ao navegador. TYPESAFE também é aceito.
TYPESAFE_API_KEY=

# Produção: configurar no Railway/secret manager. Nunca usar prefixo VITE_ aqui.
# CELLPROJECT_CLOUD_ENABLED=false permite apenas o shell público sem APIs privadas.
CELLPROJECT_CLOUD_ENABLED=false
APP_ORIGIN=https://builder.cellprojectdiary.com
APP_ALTERNATE_ORIGINS=https://cellproject-builder-production.up.railway.app
SUPABASE_URL=https://wxfootrnfiqpzhmjwgck.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Opcional depois da primeira criação da conta: reforça o UUID do usuário permitido.
SUPABASE_ALLOWED_USER_ID=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
