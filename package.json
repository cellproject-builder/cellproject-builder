{
  "name": "dynamic_diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts && npm run build:external",
    "build:external": "node scripts/build-external-worker.mjs",
    "mcp": "node server/mcp.mjs",
    "preview": "vite preview --config vite.config.ts",
    "start": "node --env-file-if-exists=.env server/production.mjs",
    "lint": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "icons:pwa": "node scripts/pwa/generate-icons.mjs",
    "test:gateway": "node --test \"server/*.test.mjs\"",
    "test:all": "npm test && npm run test:gateway",
    "check:gateway": "node scripts/check-visual-gateway.mjs",
    "check:bundle": "node scripts/audit-client-bundle.mjs --check",
    "check:repo": "node scripts/check-repository.mjs",
    "test:planning-quality": "vitest run --config docs/design/plan-quality/vitest.config.ts",
    "bench:planner": "vitest run --config scripts/planner-performance.config.ts",
    "bench:three": "node scripts/three-performance/run.mjs",
    "bench:gateway": "node scripts/planner-load.mjs",
    "test:planner-load": "node --test scripts/planner-load.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.30",
    "@ai-sdk/openai": "^2.0.50",
    "@modelcontextprotocol/server": "2.3.1",
    "@openrouter/ai-sdk-provider": "^2.8.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@xyflow/react": "^12.4.4",
    "ai": "^6.0.168",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.2.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "1.55.0",
    "nanoid": "^5.0.9",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
